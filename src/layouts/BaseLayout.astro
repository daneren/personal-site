---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'resume' | 'blog';
}

const { title, description = 'daner — ML Infra / Agentic RL', current } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" transition:persist="site-header">
      <div class="site-header-inner">
        <a class="logo" href="/">daner<span>.</span></a>
        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={current === 'home' ? 'page' : undefined}>首页</a>
          <a href="/resume" aria-current={current === 'resume' ? 'page' : undefined}>简历</a>
          <a href="/blog" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
        </nav>
      </div>
    </header>
    <main class="site-main" transition:animate="fade">
      <slot />
    </main>
    <footer class="site-footer">
      <div>© {new Date().getFullYear()} daner · <a href="mailto:minutiadaner@163.com">minutiadaner@163.com</a></div>
    </footer>
  </body>
</html>
